# =============================================================================
# RAILCONNECT — Weather Environment Configuration
# NEVER commit production API keys to frontend or source control.
# =============================================================================

# OpenWeatherMap or WeatherAPI secret key
RAILCONNECT_WEATHER_API_KEY=YOUR_API_KEY_HERE

# Base API endpoint URL
RAILCONNECT_WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# Cache TTL in seconds (e.g., 1800 = 30 minutes)
RAILCONNECT_WEATHER_CACHE_TTL=1800
